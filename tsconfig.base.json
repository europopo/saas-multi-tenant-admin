{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "jsx": "preserve",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@saas/shared": ["packages/shared/src/index.ts"],
      "@saas/shared/*": ["packages/shared/src/*"],
      "@saas/api-client": ["packages/api-client/src/index.ts"],
      "@saas/api-client/*": ["packages/api-client/src/*"],
      "@saas/mock": ["packages/mock/src/index.ts"],
      "@saas/mock/*": ["packages/mock/src/*"],
      "@saas/ui": ["packages/ui/src/index.ts"],
      "@saas/ui/*": ["packages/ui/src/*"],
      "@saas/layouts": ["packages/layouts/src/index.ts"],
      "@saas/layouts/*": ["packages/layouts/src/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
