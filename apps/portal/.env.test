# ============================================================
# portal 测试环境配置（子目录部署测试）
# 触发方式：pnpm build --mode test（或 pnpm build:iis --mode test）
# ============================================================

# 部署路径前缀（子目录部署测试场景）
# IIS 上 portal 部署在 http://host/portal/ 时设为 /portal/
VITE_APP_BASE=/portal/

# 跨应用单点登录：跳转到任务子系统的完整入口地址
# 测试场景下任务子系统部署在同主机 /task/ 子目录
VITE_TASK_URL=http://localhost/task
