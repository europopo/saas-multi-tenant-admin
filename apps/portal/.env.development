# ============================================================
# portal 本地开发环境配置
# 触发方式：pnpm dev:portal（vite dev 默认加载 .env.development）
# ============================================================

# 本地开发默认根路径（无需子目录前缀）
VITE_APP_BASE=/

# 跨应用单点登录：本地 dev 时任务子系统跑在 5174 端口
# 与源码内回退逻辑一致，显式写出便于调整
VITE_TASK_URL=http://localhost:5174
