# ============================================================
# task-system 测试环境配置（子目录部署测试）
# 触发方式：pnpm build --mode test（或 pnpm build:iis --mode test）
# ============================================================

# 部署路径前缀（子目录部署测试场景）
# IIS 上 task-system 部署在 http://host/task/ 时设为 /task/
VITE_APP_BASE=/task/

# 跨应用单点登录：跳转到门户的完整入口地址
# 测试场景下门户部署在同主机 /portal/ 子目录
VITE_PORTAL_URL=http://localhost/portal
