# 依赖
node_modules

# 构建产物
dist
dist-ssr

# 本地环境（真实密钥/本地私有配置一律忽略）
*.local
.env
.env.*.local

# 允许进版本库的模板与测试配置（不含敏感信息）
!.env.example
!.env.test
!.env.development

# 系统/编辑器
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# 测试
coverage
test-results
playwright-report
.playwright

# 缓存与临时产物
*.tsbuildinfo
*.timestamp-*.mjs
_tmp_*
.cache

# WorkBuddy 工作区数据（非项目源码）
.workbuddy
