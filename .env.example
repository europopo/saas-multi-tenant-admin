# ============================================================
# 环境变量配置说明（模板示例）
#
# 本项目为 Vite 构建的 Vue 3 SPA，环境变量按应用目录分开放置：
#   apps/portal/.env.*      → portal 门户
#   apps/task-system/.env.* → task-system 任务子系统
#
# Vite 加载规则：
#   pnpm dev:portal      → 加载 apps/portal/.env.development
#   pnpm build           → 加载 apps/*/.env.production（mode=production）
#   pnpm build --mode X  → 加载 apps/*/.env.X
#
# 只有以 VITE_ 开头的变量才会被注入到前端代码，
# 通过 import.meta.env.VITE_XXX 访问。
# ============================================================

# ------------------------------------------------------------
# 部署路径前缀（子目录部署时设置，默认 / 表示根目录）
# 例：portal 部署在 http://host/portal/ 时 → VITE_APP_BASE=/portal/
# ------------------------------------------------------------
VITE_APP_BASE=/

# ------------------------------------------------------------
# 跨应用单点登录地址（portal 与 task-system 互相跳转）
#   portal 里设置 VITE_TASK_URL    → 跳转任务子系统的完整入口
#   task-system 里设置 VITE_PORTAL_URL → 跳转门户的完整入口
# 未配置时回退到开发端口（portal:5173 / task:5174）
# ------------------------------------------------------------
# VITE_TASK_URL=http://localhost/task
# VITE_PORTAL_URL=http://localhost/portal

# ------------------------------------------------------------
# 本地开发端口（默认已在 vite.config.ts 里写死，一般无需改动）
# ------------------------------------------------------------
# portal  → 5173
# task    → 5174
